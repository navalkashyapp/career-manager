# ==========================================
# Gemini AI API Keys
# ==========================================
# Primary API key for Gemini models
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional fallback keys
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""

# ==========================================
# Firebase Admin Credentials
# ==========================================
# Either place `service-account.json` in the root folder, OR provide the raw JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# ==========================================
# Public Tunnel Configuration (Ngrok / Cloudflare)
# ==========================================
# Ngrok Auth Token (sign up at https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN="your-ngrok-authtoken"
NGROK_DOMAIN="uncolored-enzyme-unsightly.ngrok-free.dev"

# Optional Cloudflare Named Tunnel Token
# CLOUDFLARE_TUNNEL_TOKEN="your-cloudflare-tunnel-token"

# ==========================================
# Application Settings
# ==========================================
PORT=3000
NODE_ENV=production
# VITE_BACKEND_URL="https://uncolored-enzyme-unsightly.ngrok-free.dev"
USE_LOCAL_CLI=false
